<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/gradient_background"> <!-- Set background gradient -->

    <!-- App Name at the top -->
    <TextView
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DriveHub"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/primaryTextColor"
    android:layout_alignParentTop="true"
    android:layout_centerHorizontal="true"
    android:layout_marginTop="30dp" />

    <ImageView
        android:id="@+id/carImage"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/cab"
        android:contentDescription="Car Image"
        android:background="@drawable/image_bg_rounded"
        android:layout_marginTop="90dp"
        android:layout_centerHorizontal="true" />

    <!-- Notification Request Title -->
    <TextView
        android:id="@+id/notificationTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Allow DriveHub to Send Notifications?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:textColor="@color/primaryTextColor"
    android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/notificationDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DriveHub wants to send you notifications to keep you updated with your drive activities."
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:padding="10dp"
        android:layout_below="@id/notificationTitle"
        android:layout_centerHorizontal="true" />

    <Button
        android:id="@+id/btnAllow"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="Allow"
        android:textColor="@color/primaryTextColor"
        android:backgroundTint="@color/primaryButtonColor"
        android:paddingHorizontal="32dp"
        android:paddingVertical="12dp"
        android:elevation="4dp"
        android:fontFamily="sans-serif-medium"
        android:layout_below="@id/notificationDescription"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp" />


    <Button
        android:id="@+id/btnDontAllow"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="Don't Allow"
        android:textColor="@color/secondaryTextColor"
        android:backgroundTint="@color/secondaryBackground"
        android:paddingHorizontal="32dp"
        android:paddingVertical="12dp"
        android:elevation="4dp"
        android:fontFamily="sans-serif-medium"
        android:layout_below="@id/btnAllow"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="5dp" />

</RelativeLayout>

